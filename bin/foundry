def cmd_page(a):
    if a.domain == "all":
        rows = []
        for d in domains():
            areas = sorted({r.get("area") or "" for r in read_jsonl(RESEARCH / d / "records.jsonl")})
            for area in areas:
                n = cmd_page(argparse.Namespace(domain=d, area=area, out=None, quiet=True))
                rows.append((d, area, n))
        links = "".join(f'<li><a href="{d}-{ar}.html">{d} · {ar}</a> <span>{n}</span></li>' for d, ar, n in rows)
        (data_root() / "artifacts" / "index.html").write_text(
            '<!doctype html><meta charset="utf-8"><title>Foundry research</title><style>body{font:15px/1.6 -apple-system,system-ui;'
            'background:#0b0b0c;color:#e8e8ea;padding:24px}a{color:#9aa0ff}span{color:#888}</style><h1>Foundry research domains</h1>'
            f'<p>Built {time.strftime("%Y-%m-%d %H:%M")}. Look up from any agent: <code>foundry find &lt;words&gt; [--domain ui]</code></p><ul>{links}</ul>',
            encoding="utf-8")
        print(data_root() / "artifacts" / "index.html")
        return 0
    recs = read_jsonl(RESEARCH / a.domain / "records.jsonl")
    if a.area:
        recs = [r for r in recs if r.get("area") == a.area]
    recs.sort(key=lambda r: str(r.get("date") or ""), reverse=True)  # stable sorts: previews first, then curated rank, then newest
    recs.sort(key=lambda r: -int(r.get("rank") or 3))
    recs.sort(key=lambda r: not r.get("preview"))
    cards = []
    for r in recs:
        e = html.escape
        meta = " · ".join(str(x) for x in (r.get("award") or r.get("kind"), r.get("by"), r.get("date"), (r.get("sources") or [""])[0].split("/")[2] if "://" in (r.get("sources") or [""])[0] else "") if x)
        img = f'<img class="img" loading="lazy" referrerpolicy="no-referrer" alt="" src="{e(r["preview"])}">' if r.get("preview") else '<div class="img"></div>'
        s = e(" ".join([r.get("title", ""), r.get("why", ""), " ".join(r.get("tags") or []), str(r.get("by") or "")]).lower())
        cards.append(f'<a class="card" href="{e(r["url"])}" target="_blank" rel="noopener" data-s="{s}">{img}<div class="b"><div class="t">{e(r.get("title",""))}</div><div class="m">{e(meta)}</div><div class="w">{e(str(r.get("why",""))[:180])}</div></div></a>')
    counts = {}
    for r in recs:
        for t in set(r.get("tags") or []):
            counts[t] = counts.get(t, 0) + 1
    top = sorted((t for t in counts if 2 < len(t) < 24), key=lambda t: -counts[t])[:24]
    chips = "".join(f'<button onclick="c(\'{html.escape(t)}\')">{html.escape(t)} {counts[t]}</button>' for t in top)
    title = f"Foundry · {a.domain}" + (f" · {a.area}" if a.area else "")
    sub = f"{len(recs)} records, {sum(1 for r in recs if r.get('preview'))} with previews · built {time.strftime('%Y-%m-%d %H:%M')} · source: research/{a.domain}/records.jsonl"
    doc = PAGE.format(title=html.escape(title), sub=html.escape(sub), chips='<button onclick="c(\'\')">all</button>' + chips, cards="\n".join(cards))
    out = Path(a.out) if a.out else data_root() / "artifacts" / f"{a.domain}-{a.area or 'all'}.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(doc, encoding="utf-8")
    if not getattr(a, "quiet", False):
        print(out)
    return len(recs)


def cmd_serve(a):
    import functools, http.server
    if a.host in ("0.0.0.0", "::", ""):
        print("refusing to bind every interface; pass a loopback or Tailscale address", file=sys.stderr)
        return 2
    root = data_root() / "artifacts"
    root.mkdir(parents=True, exist_ok=True)
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(root))
    print(f"serving {root} on http://{a.host}:{a.port}/", flush=True)
    http.server.ThreadingHTTPServer((a.host, a.port), handler).serve_forever()


def main(argv):
    if argv and argv[0] not in OWN and not argv[0].startswith("-"):
        if CORPUS_CLI.exists():
            return subprocess.call([str(CORPUS_CLI), *argv])
        print(f"unknown subcommand {argv[0]}; see foundry --help", file=sys.stderr)
        return 2
    p = argparse.ArgumentParser(prog="foundry", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("find")
    f.add_argument("words", nargs="+")
    f.add_argument("--domain")
    f.add_argument("--area")
    f.add_argument("--kind")
    f.add_argument("--limit", type=int, default=10)
    f.add_argument("--json", action="store_true")
    f.add_argument("--no-items", action="store_true", help="skip the UI Hub items and the 21st.dev component bank")
    fr = sub.add_parser("frontier")
    fr.add_argument("--domain")
    fr.add_argument("--limit", type=int, default=10)
    st = sub.add_parser("stats")
    st.add_argument("--json", action="store_true")
    sub.add_parser("build")
    pg = sub.add_parser("page")
    pg.add_argument("domain")
    pg.add_argument("--area")
    pg.add_argument("--out")
    sv = sub.add_parser("serve")
    sv.add_argument("--host", default="127.0.0.1")
    sv.add_argument("--port", type=int, default=8766)
    a = p.parse_args(argv)
    return {"serve": cmd_serve, "find": cmd_find, "frontier": cmd_frontier, "stats": cmd_stats, "build": cmd_build, "page": cmd_page}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
