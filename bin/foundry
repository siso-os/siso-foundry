#!/usr/bin/env python3
"""foundry: look up what SISO has already mapped, before you build or search.

  foundry find <words> [--domain ui] [--area awards] [--kind site] [--limit 12] [--json]
  foundry frontier [--domain ui] [--limit 10]      the leads worth working next
  foundry stats                                    records, sources and lookups per domain
  foundry build                                    merge observations into records and frontier
  foundry page <domain> [--area awards] [--out F]  an HTML index with previews
  foundry serve --host <tailscale-ip> [--port 8766] serve the generated pages (never on 0.0.0.0)

Records live in research/<domain>/records.jsonl (Git). Lookups are counted in
$FOUNDRY_DATA/usage/find.jsonl on the machine that ran them. Any other subcommand
(repos, transcripts, people, ...) is passed to the corpus CLI from the foundry-corpus skill.
Exit codes: 0 found, 2 usage, 3 nothing found.
"""
import argparse, math, hashlib, html, json, os, re, socket, subprocess, sys, time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RESEARCH = ROOT / "research"
UI_HUB_ITEMS = ROOT.parent / "banks" / "siso-ui-hub" / "sources" / "items.jsonl"
# The 21st.dev component bank (8.5k components, previews, source): beside the Foundry on the laptop, a sparse clone on the mini.
COMPONENT_BANK = [Path(os.environ["FOUNDRY_COMPONENT_BANK"])] if os.environ.get("FOUNDRY_COMPONENT_BANK") else [
    ROOT.parent / "banks" / "siso-component-bank" / "index.jsonl",
    Path("/Volumes/SISO-STORAGE-VAULT/foundry-data/clones/siso-component-bank/index.jsonl")]
CORPUS_CLI = Path.home() / ".claude" / "skills" / "foundry-corpus" / "foundry"
OWN = {"find", "frontier", "stats", "build", "page", "serve"}


def data_root():
    env = os.environ.get("FOUNDRY_DATA")
    return Path(env).expanduser() if env else Path.home() / ".local" / "share" / "siso-foundry"


def domains():
    return sorted(p.name for p in RESEARCH.iterdir() if p.is_dir() and (p / "observations").is_dir())


def read_jsonl(path):
    if not path.exists():
        return []
    rows = []
    for n, line in enumerate(path.read_text(encoding="utf-8").split("\n"), 1):  # not splitlines: U+2028 lives inside titles
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            print(f"skip {path.name}:{n}: not JSON", file=sys.stderr)
    return rows


def write_jsonl(path, rows):
    path.write_text("".join(json.dumps(r, ensure_ascii=False, sort_keys=True) + "\n" for r in rows), encoding="utf-8")


# ---------------------------------------------------------------- identity

GH = re.compile(r"github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)")


def github_of(row):
    gh = (row.get("github") or "").strip().strip("/")
    if gh.count("/") == 1:
        return gh.lower().removesuffix(".git")
    m = GH.search(row.get("url") or "")
    if m and m.group(1).lower() not in {"topics", "orgs", "sponsors", "features", "marketplace", "collections"}:
        return f"{m.group(1)}/{m.group(2)}".lower().removesuffix(".git")
    return ""


def url_key(url):
    u = (url or "").strip().lower()
    u = re.sub(r"^https?://", "", u)
    u = re.sub(r"^(www\.|m\.)", "", u)
    u = u.split("#")[0]
    if "youtube.com/watch" in u or "youtu.be/" in u:
        m = re.search(r"(?:v=|youtu\.be/)([\w-]{11})", u)
        return f"youtube:{m.group(1)}" if m else u
    u = u.split("?")[0]
    return u.rstrip("/")


def key_of(row):
    gh = github_of(row)
    # A repo's own page and its GitHub URL are one thing; a site that merely links its repo stays a site.
    if gh and ("github.com" in (row.get("url") or "") or row.get("kind") in {"repo", "library", "list", "registry", "block-library", "template", "tool", "framework"}):
        return "gh:" + gh
    return "url:" + url_key(row.get("url"))


def new_id(key):
    return "f-" + hashlib.sha1(key.encode()).hexdigest()[:10]


# ---------------------------------------------------------------- build

FIELDS = ("title", "kind", "area", "licence", "preview", "why", "by", "date", "stars", "free", "award")


def build_domain(domain):
    base = RESEARCH / domain
    obs_dir = base / "observations"
    old = {r["key"]: r for r in read_jsonl(base / "records.jsonl")}
    aliases = {a: r["key"] for r in old.values() for a in r.get("aliases", [])}
    records, leads, bad = {}, {}, 0
    for path in sorted(obs_dir.glob("*.jsonl")):
        frontier = path.name.endswith(".frontier.jsonl")
        for row in read_jsonl(path):
            if frontier:
                lead = (row.get("lead") or "").strip()
                if not lead:
                    continue
                k = lead.lower()
                cur = leads.setdefault(k, {"lead": lead, "why": row.get("why", ""), "rank": 0, "area": row.get("area", ""), "from": [], "status": "open"})
                cur["rank"] = max(cur["rank"], int(row.get("rank") or 0))
                if path.stem not in cur["from"]:
                    cur["from"].append(path.stem.replace(".frontier", ""))
                continue
            if not row.get("url") or not row.get("title"):
                bad += 1
                continue
            k = key_of(row)
            k = aliases.get(k, k)
            prev = old.get(k, {})
            cur = records.get(k)
            if cur is None:
                cur = records[k] = {
                    "id": prev.get("id") or new_id(k), "key": k, "domain": domain, "url": row["url"],
                    "github": github_of(row), "tags": [], "sources": [], "first_seen": prev.get("first_seen") or time.strftime("%Y-%m-%d"),
                    "aliases": prev.get("aliases", []), "n_obs": 0,
                }
                for f in FIELDS:
                    cur[f] = prev.get(f, "")
            cur["n_obs"] += 1
            for f in FIELDS:
                v = row.get(f)
                if v not in (None, "", []) and (not cur.get(f) or f in ("stars",)):
                    cur[f] = v
            for t in row.get("tags") or []:
                t = str(t).lower().strip()
                if t and t not in cur["tags"]:
                    cur["tags"].append(t)
            src = row.get("source") or path.stem
            if src not in cur["sources"]:
                cur["sources"].append(src)
    # A record that vanished from every observation file is kept: history is append-only.
    for k, prev in old.items():
        records.setdefault(k, prev)
    apply_facts(base, records.values())
    apply_curation(base, records.values())
    for o in read_jsonl(base / "frontier-rank.jsonl"):  # RESEARCH's re-ranking beats a harvester's own rank
        if o.get("lead", "").lower() in leads:
            leads[o["lead"].lower()]["rank"] = int(o["rank"])
            leads[o["lead"].lower()]["why"] = o.get("why") or leads[o["lead"].lower()]["why"]
    done = {d["lead"].lower(): d for d in read_jsonl(base / "frontier-done.jsonl")}
    for k, lead in leads.items():
        if k in done:
            lead["status"], lead["result"] = "done", done[k].get("result", "")
    known = {url_key(r["url"]) for r in records.values()} | {r["github"] for r in records.values() if r.get("github")}
    for lead in leads.values():
        if lead["status"] == "open" and url_key(lead["lead"]) in known or lead["lead"].lower().strip("/") in known:
            lead["status"] = "covered"
    rejected = sorted((r for r in records.values() if r.get("rejected")), key=lambda r: r["id"])
    rec_rows = sorted((r for r in records.values() if not r.get("rejected")), key=lambda r: (r.get("area") or "", r["id"]))
    write_jsonl(base / "rejected.jsonl", rejected)
    lead_rows = sorted(leads.values(), key=lambda r: (r["status"] != "open", -r["rank"], r["lead"]))
    write_jsonl(base / "records.jsonl", rec_rows)
    write_jsonl(base / "frontier.jsonl", lead_rows)
    return len(rec_rows), sum(1 for l in lead_rows if l["status"] == "open"), bad


def apply_facts(base, records):
    """Fold in what research/tools/probe.py observed at the source: liveness, og:image, GitHub's own numbers."""
    probes = {p["url"]: p for p in read_jsonl(base / "probes.jsonl")}  # later lines win
    repos = {g["github"]: g for g in read_jsonl(base / "github.jsonl")}
    stacks = {x["url"]: x for x in read_jsonl(base / "stacks.jsonl") if not x.get("error")}
    for r in records:
        st = stacks.get(r["url"])
        if st:
            r["stack"] = st["stack"]
            r["tags"] = [t for t in r["tags"] if not t.startswith("uses:")] + [f"uses:{x}" for x in st["stack"]]
        p = probes.get(r["url"])
        if p and "://github.com/" in r["url"]:
            p = None  # GitHub rate-limits page fetches; github.jsonl from its API is the authority for repos
        if p:
            r["http"] = p.get("status", 0)
            if not r.get("preview") and p.get("og_image"):
                r["preview"] = p["og_image"]
            if p.get("og_description"):
                r["desc"] = p["og_description"]
        g = repos.get(r.get("github"))
        if p and p.get("status") in (404, 410):
            r["rejected"] = f"url returned {p['status']}"
        if g and not g.get("found"):
            r["rejected"] = "GitHub has no such repository"
        elif g:
            r["stars"], r["archived"], r["pushed"] = g["stars"], g["archived"], g["pushed"]
            if g.get("licence") and g["licence"] != "NOASSERTION":
                r["licence"] = g["licence"]
            if g.get("description"):
                r["desc"] = g["description"]
            if not r.get("preview"):
                r["preview"] = f"https://opengraph.githubassets.com/1/{r['github']}"


def apply_curation(base, records):
    """Judgments by RESEARCH or its curators, lines keyed by record id in research/<domain>/curation/*.jsonl; later keys win."""
    verdicts = {}
    for path in sorted((base / "curation").glob("*.jsonl")):
        for c in read_jsonl(path):
            if c.get("id"):
                verdicts.setdefault(c["id"], {}).update(c)
    for r in records:
        c = verdicts.get(r["id"])
        if not c:
            continue
        if c.get("verdict") == "drop":
            r["rejected"] = "curated out: " + (c.get("note") or c.get("why") or "off-topic")
            continue
        if c.get("rank"):
            r["rank"] = int(c["rank"])
        if c.get("why"):
            r["why"] = c["why"]
        if c.get("licence"):
            r["licence"] = c["licence"]
        for t in c.get("tags") or []:
            if t not in r["tags"]:
                r["tags"].append(t)


# ---------------------------------------------------------------- find

def tokens(text):
    return [t for t in re.split(r"[^a-z0-9+#.]+", str(text or "").lower()) if t]


def has(field_tokens, w):
    # Short words ("ui", "3d", "ag") match whole tokens only; longer ones match prefixes ("anim" finds "animation").
    return w in field_tokens if len(w) <= 2 else any(t.startswith(w) for t in field_tokens)


def squash(text):
    return re.sub(r"[^a-z0-9]", "", str(text).lower())


def score(row, words, phrase=""):
    title = tokens(row.get("title", ""))
    tags = tokens(" ".join(row.get("tags") or []))
    rest = tokens(" ".join(str(row.get(f) or "") for f in ("why", "kind", "area", "by", "url", "github", "desc", "lib")))
    s = 0
    for w in words:
        got = 4 * has(title, w) + 2 * has(tags, w) + has(rest, w)
        if not got:  # every word must appear somewhere
            return 0
        s += got
    if len(phrase) > 3 and (phrase in squash(row.get("title", "")) or phrase in squash(row.get("url", ""))):
        s += 8  # the query as written, e.g. "ag-ui" or "three.js", names this thing
    used = math.log10(int(row.get("installs") or 0) + 1) / 1.5  # catalogue installs: 10k installs adds 2.7
    return s + int(row.get("rank") or 3) / 2 + min(int(row.get("stars") or 0), 100000) / 100000 + used


def ui_hub_rows():
    for r in read_jsonl(UI_HUB_ITEMS):
        yield {"id": r.get("id"), "title": r.get("title") or r.get("name"), "kind": r.get("kind"), "area": "ui-hub-item",
               "domain": "ui", "url": r.get("url"), "why": r.get("desc", ""), "tags": [r.get("lib", ""), r.get("lib_cat", "")],
               "lib": r.get("lib", ""), "licence": r.get("tier", ""), "rank": 3}


def component_bank_rows():
    path = next((p for p in COMPONENT_BANK if p.exists()), None)
    for r in read_jsonl(path) if path else []:
        cls = r.get("classification") or ""
        cat = re.search(r"'category': \[([^\]]*)\]", cls) if isinstance(cls, str) else None
        prev = r.get("upstream_preview") or ""
        yield {"id": "bank:" + r.get("id", ""), "title": r.get("name") or r.get("slug"), "kind": "component", "area": "component-bank",
               "domain": "ui", "url": r.get("url"), "why": r.get("description", ""), "by": r.get("author", ""),
               "tags": [t.strip(" '") for t in (cat.group(1).split(",") if cat else [])] + ["21st.dev"],
               "preview": prev if prev.startswith("http") else "", "licence": "has source" if str(r.get("has_source")) == "True" else "", "rank": 2}


def registry_directory_rows():
    """Every public shadcn registry item, from the newest registry.directory snapshot on the data plane."""
    snaps = sorted(Path("/Volumes/SISO-STORAGE-VAULT/foundry-data/research/ui").glob("registry-directory-items-*.json")) + \
        sorted((data_root() / "research" / "ui").glob("registry-directory-items-*.json"))
    if not snaps:
        return
    for it in json.loads(snaps[-1].read_text())["items"]:
        reg = it.get("registry") or {}
        yield {"id": f"rd:{reg.get('basePath', '')}/{it.get('name')}", "title": it.get("name"), "kind": (it.get("type") or "").replace("registry:", ""),
               "area": "registry-item", "domain": "ui", "url": f"https://registry.directory{reg.get('basePath', '')}/{it.get('name')}",
               "why": it.get("description") or "", "by": reg.get("name", ""), "tags": (it.get("categories") or []) + [reg.get("name", "")],
               "licence": reg.get("name", ""), "rank": 2}


def agent_catalog_rows():
    """Claude Code skills and plugins (claude-plugins.dev, SkillsMP) and official MCP Registry servers, from the newest
    agent_catalogs.py index on the data plane."""
    snaps = sorted(Path("/Volumes/SISO-STORAGE-VAULT/foundry-data/research/agent-bases").glob("agent-catalog-items-*.jsonl")) + \
        sorted((data_root() / "research" / "agent-bases").glob("agent-catalog-items-*.jsonl"))
    if not snaps:
        return
    for it in read_jsonl(snaps[-1]):
        it.update(domain="agent-bases", rank=2, licence=it.get("licence") or "see source")
        yield it


def count_lookup(entry):
    try:
        d = data_root() / "usage"
        d.mkdir(parents=True, exist_ok=True)
        with open(d / "find.jsonl", "a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry) + "\n")
    except OSError:
        pass  # counting never breaks a lookup


def cmd_find(a):
    words = tokens(" ".join(a.words))
    if not words:
        print("usage: foundry find <words> [--domain ui]", file=sys.stderr)
        return 2
    rows = []
    for d in domains():
        if a.domain and d != a.domain:
            continue
        rows += read_jsonl(RESEARCH / d / "records.jsonl")
    if (not a.domain or a.domain == "ui") and not a.no_items:
        rows += list(ui_hub_rows()) + list(component_bank_rows()) + list(registry_directory_rows())
    if (not a.domain or a.domain == "agent-bases") and not a.no_items:
        rows += list(agent_catalog_rows())
    if a.area:
        rows = [r for r in rows if r.get("area") == a.area]
    if a.kind:
        rows = [r for r in rows if r.get("kind") == a.kind]
    phrase = squash(" ".join(a.words))
    ranked = sorted(((score(r, words, phrase), r) for r in rows), key=lambda x: -x[0])
    hits = [r for s, r in ranked if s > 0]
    count_lookup({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": socket.gethostname().split(".")[0], "q": " ".join(a.words),
                  "domain": a.domain or "", "hits": len(hits), "agent": os.environ.get("SISO_AGENT_NAME") or os.environ.get("HERDR_PANE_NAME") or ""})
    shown = hits[: a.limit]
    if a.json:
        print(json.dumps({"query": " ".join(a.words), "total": len(hits), "results": shown}, ensure_ascii=False))
        return 0 if hits else 3
    if not hits:
        print(f"NOT FOUND in {sum(1 for _ in rows)} records. Add it to the frontier if it matters.")
        return 3
    print(f"{len(hits)} hits for '{' '.join(a.words)}'" + (f" in {a.domain}" if a.domain else "") + f", top {len(shown)}:")
    for r in shown:
        extra = []
        if r.get("stars"):
            extra.append(f"★{r['stars']}")
        if r.get("licence"):
            extra.append(str(r["licence"])[:20])
        meta = f"{r.get('domain','')}/{r.get('area','')}/{r.get('kind','')}" + (f" · {' · '.join(extra)}" if extra else "")
        print(f"- {r.get('title','')[:60]}  [{meta}]\n  {r.get('url','')}\n  {str(r.get('why') or '')[:140]}")
    return 0


# ---------------------------------------------------------------- frontier, stats

def cmd_frontier(a):
    shown = 0
    for d in domains():
        if a.domain and d != a.domain:
            continue
        open_leads = [l for l in read_jsonl(RESEARCH / d / "frontier.jsonl") if l.get("status") == "open"]
        print(f"{d}: {len(open_leads)} open leads")
        for l in open_leads[: a.limit]:
            print(f"  {l['rank']}  {l['lead'][:90]}  ({l.get('area','')}) {l.get('why','')[:90]}")
            shown += 1
    return 0 if shown else 3


def cmd_stats(a):
    out = {}
    for d in domains():
        recs = read_jsonl(RESEARCH / d / "records.jsonl")
        leads = read_jsonl(RESEARCH / d / "frontier.jsonl")
        areas = {}
        for r in recs:
            areas[r.get("area") or "?"] = areas.get(r.get("area") or "?", 0) + 1
        sources = {s for r in recs for s in r.get("sources", [])}
        out[d] = {"records": len(recs), "with_preview": sum(1 for r in recs if r.get("preview")), "sources": len(sources),
                  "open_leads": sum(1 for l in leads if l.get("status") == "open"), "areas": areas}
    lookups = read_jsonl(data_root() / "usage" / "find.jsonl")
    out["_lookups_this_machine"] = {"total": len(lookups), "found": sum(1 for l in lookups if l.get("hits"))}
    print(json.dumps(out, indent=1) if a.json else "\n".join(f"{k}: {v}" for k, v in out.items()))
    return 0


def cmd_build(a):
    for d in domains():
        n, leads, bad = build_domain(d)
        print(f"{d}: {n} records, {leads} open leads" + (f", {bad} rows skipped (no url or title)" if bad else ""))
    return 0


# ---------------------------------------------------------------- page

